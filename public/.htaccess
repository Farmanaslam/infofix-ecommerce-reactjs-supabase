Options -MultiViews
RewriteEngine On

# SPA — serve index.html for all non-file, non-dir requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [QSA,L]

# Old WordPress product categories → shop
Redirect 301 /product-category/all/ https://infofixcomputers.com/shop
Redirect 301 /product-category/accessories/ https://infofixcomputers.com/shop
Redirect 301 /product-category/laptops/ https://infofixcomputers.com/shop
Redirect 301 /product-category/desktops/ https://infofixcomputers.com/shop
Redirect 301 /product-category/refurbished/ https://infofixcomputers.com/buy-refurbished-laptop

# Old WordPress slugs → new React (trailing-slash versions ONLY — no-slash handled by SPA)
Redirect 301 /our-branches/ https://infofixcomputers.com/branches
Redirect 301 /about-us/ https://infofixcomputers.com/about
Redirect 301 /contact-us/ https://infofixcomputers.com/contact
Redirect 301 /my-account/ https://infofixcomputers.com/profile

# DO NOT add /blog/ /careers/ /services/ /shop/ here — causes loops

# Old product pages → shop
RedirectMatch 301 ^/product/(.*)$ https://infofixcomputers.com/shop

# WordPress junk — 410 Gone (better than 301 for SEO)
RedirectMatch 410 ^/wp-admin
RedirectMatch 410 ^/wp-login
RedirectMatch 410 ^/wp-content
RedirectMatch 410 ^/wp-includes
RedirectMatch 410 ^/[0-9]{4}/[0-9]{2}/[0-9]{2}/.*$

# Performance headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>